ARG GDAL_VERSION=3.12.4
ARG PYTHON_VERSION=3.12

ARG BASE_DIR=/opt/geosgb

ARG MAPSERVER_VERSION=8.6.6
# SHA256 of mapserver-${MAPSERVER_VERSION}.tar.gz, from the "digest" of the GitHub release asset
ARG MAPSERVER_SHA256=e908e76b65541042042e9c5e4ae16a131f064cf6d3c76e9542c89b25158968c9


FROM docker.io/ndscprm/gdal:${GDAL_VERSION}-py${PYTHON_VERSION}-devel AS compile

SHELL [ "/bin/bash", "-o", "pipefail", "-c" ]

ARG MAPSERVER_VERSION
ARG MAPSERVER_SHA256
ARG BASE_DIR

# Same hardening flags as the GDAL base image: Debian's gcc does not enable them by default and mapserv
# parses untrusted requests. Build args are not inherited from the base image, so they are repeated here
ARG HARDENING_CFLAGS="-fstack-protector-strong -fstack-clash-protection -D_FORTIFY_SOURCE=3"
ARG HARDENING_LDFLAGS="-Wl,-z,relro,-z,now"

# Install deps
RUN apt-get -y update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        libfreetype-dev \
        libfcgi-dev && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/*

# Release (default, also the published -devel): -O3, no debug symbols. RelWithDebInfo: the same -O3 code plus
# debug symbols, for a -devel built locally to debug MapServer (the staging stage strips the release anyway, so
# its binaries are the same). The source tree stays in the -devel either way
ARG MAPSERVER_BUILD_TYPE=Release

# Compile and install Mapserver
RUN case "${MAPSERVER_BUILD_TYPE}" in \
        Release | RelWithDebInfo) ;; \
        *) echo "MAPSERVER_BUILD_TYPE must be Release or RelWithDebInfo, not '${MAPSERVER_BUILD_TYPE}'" >&2; exit 1 ;; \
    esac && \
    MAPSERVER_URL=https://github.com/MapServer/MapServer/releases/download/rel-${MAPSERVER_VERSION//./-}/mapserver-${MAPSERVER_VERSION}.tar.gz && \
    wget -q "${MAPSERVER_URL}" && \
    echo "${MAPSERVER_SHA256}  mapserver-${MAPSERVER_VERSION}.tar.gz" | sha256sum -c - && \
    # keep the source tree in the image for reference and for debugging (RelWithDebInfo symbols point to it)
    mkdir -p "${BASE_DIR}/src" && \
    tar -zxf "mapserver-${MAPSERVER_VERSION}.tar.gz" -C "${BASE_DIR}/src" && \
    rm "mapserver-${MAPSERVER_VERSION}.tar.gz" && \
    MAPSERVER_DIR=${BASE_DIR}/src/mapserver-${MAPSERVER_VERSION} && \
    mkdir -p "$MAPSERVER_DIR/build" && \
    # line-buffer MS_ERRORFILE when it is a file/FIFO (fully buffered by default), so each message is
    # written at once and messages from concurrent workers don't interleave (see fcgi/start.sh)
    sed -i 's|^\( *\)debuginfo->debug_mode = MS_DEBUGMODE_FILE;|&\n\1setvbuf(debuginfo->fp, NULL, _IOLBF, 0);|' "$MAPSERVER_DIR/src/mapdebug.c" && \
    grep -q "setvbuf(debuginfo->fp, NULL, _IOLBF, 0);" "$MAPSERVER_DIR/src/mapdebug.c" && \
    # ORACLE_HOME is only read by cmake (WITH_ORACLESPATIAL); use the Instant Client shipped by the base image
    ORACLE_HOME=$(echo "${BASE_DIR}"/oracle/instantclient_*) && \
    test -d "$ORACLE_HOME" && \
    # the install target writes MapScript to ${BASE_DIR}/lib/python3.*, removed below: fail if the base image
    # already has something there, instead of removing it
    if compgen -G "${BASE_DIR}/lib/python3.*" > /dev/null; then \
        echo "${BASE_DIR}/lib/python3.* already exists in the base image" >&2; exit 1; \
    fi && \
    ( cd "$MAPSERVER_DIR/build" && \
    ORACLE_HOME="$ORACLE_HOME" cmake \
        -DCMAKE_C_FLAGS="${HARDENING_CFLAGS}" \
        -DCMAKE_CXX_FLAGS="${HARDENING_CFLAGS}" \
        -DCMAKE_SHARED_LINKER_FLAGS="${HARDENING_LDFLAGS}" \
        -DCMAKE_EXE_LINKER_FLAGS="${HARDENING_LDFLAGS}" \
        -DCMAKE_MODULE_LINKER_FLAGS="${HARDENING_LDFLAGS}" \
        # Release is -O3 -DNDEBUG; RelWithDebInfo gets the same -O3 (its default is -O2) plus -g
        -DCMAKE_BUILD_TYPE=${MAPSERVER_BUILD_TYPE} \
        -DCMAKE_C_FLAGS_RELWITHDEBINFO="-O3 -g -DNDEBUG" \
        -DCMAKE_CXX_FLAGS_RELWITHDEBINFO="-O3 -g -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX=${BASE_DIR} \
        # GNUInstallDirs would default to /etc/opt/... for an /opt prefix
        -DMAPSERVER_CONFIG_FILE=${BASE_DIR}/etc/mapserver.conf \
        -DWITH_CLIENT_WFS=OFF \
        -DWITH_CLIENT_WMS=OFF \
        -DWITH_CURL=OFF \
        -DWITH_SOS=OFF \
        -DWITH_SVGCAIRO=OFF \
        -DWITH_PROTOBUFC=OFF \
        -DWITH_FRIBIDI=OFF \
        -DWITH_HARFBUZZ=OFF \
        -DWITH_CAIRO=OFF \
        -DWITH_LIBXML2=ON \
        -DWITH_ORACLESPATIAL=ON \
        -DWITH_GIF=OFF \
        # Python MapScript (SWIG, from the base image), built with the Python of the base image venv
        -DWITH_PYTHON=ON \
        -DPython_EXECUTABLE=${BASE_DIR}/venv/bin/python \
        -Wno-dev \
    .. && \
    cmake --build . --parallel "$(nproc)" --target install && \
    # list of installed files, used by the staging stage to pick MapServer out of ${BASE_DIR}
    cp install_manifest.txt "${BASE_DIR}/share/mapserver/install_manifest.txt" && \
    # MapScript wheel: setup.py (generated by cmake) only packages the _mapscript module built above with the
    # cmake flags (hardening included), so it is built offline with the setuptools/wheel pinned by the base image.
    # /wheels stays in the -devel on purpose: staging repacks it for release-mapscript, and it can be installed in a
    # venv of your own wherever this MapServer build is (it links ${BASE_DIR}/lib/libmapserver.so)
    ( cd src/mapscript/python && \
      ${BASE_DIR}/venv/bin/pip wheel --no-cache-dir --no-build-isolation --no-deps -w /wheels . ) ) && \
    # the install target also runs "pip install --prefix=${BASE_DIR}", outside the venv
    # (${BASE_DIR}/lib/python3.*, not in the install manifest, checked above not to come from the base image):
    # replaced by the wheel, installed in the venv
    rm -rf "${BASE_DIR}"/lib/python3.* && \
    ${BASE_DIR}/venv/bin/pip install --no-cache-dir --no-index --no-deps /wheels/mapscript-*.whl && \
    rm -rf "$MAPSERVER_DIR/build" && \
    ldconfig && \
    ${BASE_DIR}/venv/bin/python -c "import mapscript; print('mapscript', mapscript.MS_VERSION)"

SHELL [ "/bin/sh", "-c" ]


# Development image (-devel tag): toolchain, headers and sources from the GDAL -devel base, Python MapScript in
# its venv (installed by the compile stage), plus
# the same FastCGI setup as the release, so MapServer can be run and debugged here (docker run ... /start.sh)
FROM compile AS build

ARG BASE_DIR

RUN apt-get -y update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        # used by data/fonts.txt
        fonts-liberation \
        # cgi-fcgi, used by /usr/local/bin/healthcheck
        libfcgi-bin \
        multiwatch \
        spawn-fcgi && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/*

COPY etc/mapserver.conf etc/healthcheck.map ${BASE_DIR}/etc/
COPY --chmod=755 fcgi/start.sh /start.sh
COPY --chmod=755 docker/healthcheck /usr/local/bin/healthcheck
COPY data /var/lib/mapserver/data

# Sample data with deterministic modes (owned by root, writable by nobody else, nothing executable), regardless
# of the checkout umask: mapfiles are loaded from /var/lib/mapserver (MS_MAP_PATTERN), so the server must not be
# able to write one there. The release copies /var/lib/mapserver from here
RUN find /var/lib/mapserver -type d -exec chmod 755 {} + && \
    find /var/lib/mapserver -type f -exec chmod 644 {} +

# a single worker by default, easier to follow with gdb (installed on demand: apt-get install gdb;
# gdb -p needs --cap-add=SYS_PTRACE)
ENV MAPSERVER_FCGI_PORT=8080 \
    MAPSERVER_WORKERS=1

EXPOSE 8080


# Throwaway stage: MapServer files only (GDAL and Oracle come with the release base image),
# stripped, plus the Debian packages they link against
FROM compile AS staging

SHELL [ "/bin/bash", "-o", "pipefail", "-c" ]

ARG BASE_DIR

# Copy the files listed in the cmake install manifest to /tmp/mapserver, dropping build-only files
RUN mkdir /tmp/mapserver && \
    tar -cf - -P --files-from="${BASE_DIR}/share/mapserver/install_manifest.txt" | tar -xf - -P --transform 's|^/|/tmp/mapserver/|' && \
    rm -rf \
        "/tmp/mapserver${BASE_DIR}/include" \
        "/tmp/mapserver${BASE_DIR}/lib/pkgconfig" \
        "/tmp/mapserver${BASE_DIR}/share/mapserver/cmake" && \
    find /tmp/mapserver -type f \
        -exec sh -c 'file -b "$1" | grep -q "^ELF"' _ {} \; \
        -exec strip --strip-debug {} +

# MapScript wheel for release-mapscript, with its _mapscript module stripped too (debug symbols with
# MAPSERVER_BUILD_TYPE=RelWithDebInfo): unpacked, stripped and packed again (pack rewrites the RECORD hashes)
RUN mkdir /tmp/wheels /tmp/wheel-src && \
    for whl in /wheels/*.whl; do \
        ${BASE_DIR}/venv/bin/python -m wheel unpack -d /tmp/wheel-src "$whl" && \
        find /tmp/wheel-src -name '*.so' -exec strip --strip-debug {} + && \
        ${BASE_DIR}/venv/bin/python -m wheel pack -d /tmp/wheels /tmp/wheel-src/* && \
        rm -rf /tmp/wheel-src/*; \
    done && \
    ls -l /tmp/wheels

# Runtime packages: every shared library linked by MapServer outside ${BASE_DIR}, resolved to its real
# path and mapped to the Debian package that owns it (most of them are already in the release image).
# Fails if a library is missing or not owned by any package (e.g. something under /usr/local).
RUN find /tmp/mapserver -type f \
        -exec sh -c 'file -b "$1" | grep -q "^ELF"' _ {} \; -print0 | \
        xargs -0 -n1 ldd > /tmp/ldd.txt && \
    if grep 'not found' /tmp/ldd.txt; then exit 1; fi && \
    awk '$2 == "=>" && $3 ~ /^\// { print $3 }' /tmp/ldd.txt | xargs realpath | sort -u | \
        grep -v "^${BASE_DIR}/" > /tmp/runtime-libs.txt && \
    while read -r lib; do \
        dpkg -S "$lib" 2>/dev/null || dpkg -S "${lib#/usr}" || { echo "No package owns $lib" >&2; exit 1; }; \
    done < /tmp/runtime-libs.txt | sed 's/: .*//' | sort -u > /tmp/runtime-packages.txt && \
    cat /tmp/runtime-packages.txt

SHELL [ "/bin/sh", "-c" ]


# The same FastCGI server as release, on the GDAL image with Python (same GDAL build as the -devel one), plus
# Python MapScript in its venv. Defined before release, which stays the last stage (default target).
# Keep both stages in sync: apart from FROM, the description label and the MapScript RUN, they are the same text
FROM docker.io/ndscprm/gdal:${GDAL_VERSION}-py${PYTHON_VERSION} AS release-mapscript

ARG BASE_DIR
ARG MAPSERVER_VERSION

LABEL org.opencontainers.image.title="MapServer SGB/CPRM" \
      org.opencontainers.image.description="MapServer FastCGI e Python MapScript compilados a partir do código fonte, com suporte a Oracle Spatial" \
      org.opencontainers.image.vendor="SGB/CPRM" \
      org.opencontainers.image.version="${MAPSERVER_VERSION}" \
      org.opencontainers.image.source="https://github.com/nds-cprm/mapserver-oci" \
      org.opencontainers.image.authors="Carlos Eduardo Mota <carlos.mota@sgb.gov.br>"

RUN --mount=type=bind,from=staging,source=/tmp/runtime-packages.txt,target=/tmp/runtime-packages.txt \
    apt-get -y update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        $(cat /tmp/runtime-packages.txt) \
        # used by data/fonts.txt
        fonts-liberation \
        # cgi-fcgi, used by /usr/local/bin/healthcheck
        libfcgi-bin \
        multiwatch \
        spawn-fcgi && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/*

COPY --from=staging /tmp/mapserver/ /
COPY etc/mapserver.conf etc/healthcheck.map ${BASE_DIR}/etc/
COPY --chmod=755 fcgi/start.sh /start.sh
# health check command shared by every runtime (see HEALTHCHECK below)
COPY --chmod=755 docker/healthcheck /usr/local/bin/healthcheck
# HOME=/var/lib/mapserver, read-only, for every user (the nss_wrapper script would switch it to /tmp);
# not executable, so the entrypoint sources it and its HOME reaches the container command
COPY --chmod=644 docker/20-mapserver-home.sh /docker-entrypoint.d/20-mapserver-home.sh

# libmapserver in the ld.so cache (the MapServer ELF files also have RUNPATH=${BASE_DIR}/lib)
RUN ldconfig

# MapScript from the wheel of the staging stage, offline and without dependencies (it has none), so no package
# of the base image changes. Then the constraints of the resulting venv (base image packages + mapscript) are
# written to ${BASE_DIR}/share/mapserver/constraints.txt, for derived images:
# pip install -c ${BASE_DIR}/share/mapserver/constraints.txt ... cannot replace any of them.
# "pip list --format=freeze", not "pip freeze": packages installed from a local wheel (pyarrow in the base image,
# mapscript here) would be written as "name @ file:///tmp/...", a path that does not exist in other images
RUN --mount=type=bind,from=staging,source=/tmp/wheels,target=/tmp/wheels \
    pip install --no-cache-dir --no-index --no-deps /tmp/wheels/mapscript-*.whl && \
    pip check && \
    python -c "import mapscript; print('mapscript', mapscript.MS_VERSION)" && \
    pip list --format=freeze > "${BASE_DIR}/share/mapserver/constraints.txt" && \
    grep -q '^mapscript==' "${BASE_DIR}/share/mapserver/constraints.txt"

# sample data with the modes set in build: nothing writable by the server (/var/lib/mapserver itself is created 755)
COPY --from=build /var/lib/mapserver/ /var/lib/mapserver/

WORKDIR /var/lib/mapserver

# MS_ERRORFILE is left unset: fcgi/start.sh then sends MapServer errors to the container log
ENV MAPSERVER_FCGI_PORT=8080 \
    MAPSERVER_WORKERS=4 \
    HOME=/var/lib/mapserver

# unprivileged by default. UID 1000 is not in /etc/passwd on purpose: the base image nss_wrapper creates
# a virtual user for it at start (USER_NAME, default sgb), as it does for arbitrary UIDs (OpenShift).
# HOME is /var/lib/mapserver for every user, read-only whatever the GID (docker/20-mapserver-home.sh)
USER 1000:0

# FastCGI, not HTTP: put a web server in front, on the same network, and don't publish the port
EXPOSE 8080

# FastCGI request answered by a mapserv worker (docker/healthcheck): fails if no worker is serving.
# Only applied by Docker: Podman ignores it in OCI images and Kubernetes never uses it, so Compose,
# Quadlet and probes call the same script
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD [ "healthcheck" ]

# ENTRYPOINT (/docker-entrypoint.sh) is inherited from the base image
CMD [ "/start.sh" ]


# MapServer as a FastCGI server (multiwatch-managed workers behind spawn-fcgi). Based on the GDAL image without
# Python (-nopy, same GDAL build as the -devel one), as nothing here uses it; Python MapScript is in release-mapscript.
# Keep release-mapscript in sync with this stage
FROM docker.io/ndscprm/gdal:${GDAL_VERSION}-nopy AS release

ARG BASE_DIR
ARG MAPSERVER_VERSION

LABEL org.opencontainers.image.title="MapServer SGB/CPRM" \
      org.opencontainers.image.description="MapServer FastCGI compilado a partir do código fonte, com suporte a Oracle Spatial" \
      org.opencontainers.image.vendor="SGB/CPRM" \
      org.opencontainers.image.version="${MAPSERVER_VERSION}" \
      org.opencontainers.image.source="https://github.com/nds-cprm/mapserver-oci" \
      org.opencontainers.image.authors="Carlos Eduardo Mota <carlos.mota@sgb.gov.br>"

RUN --mount=type=bind,from=staging,source=/tmp/runtime-packages.txt,target=/tmp/runtime-packages.txt \
    apt-get -y update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        $(cat /tmp/runtime-packages.txt) \
        # used by data/fonts.txt
        fonts-liberation \
        # cgi-fcgi, used by /usr/local/bin/healthcheck
        libfcgi-bin \
        multiwatch \
        spawn-fcgi && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/*

COPY --from=staging /tmp/mapserver/ /
COPY etc/mapserver.conf etc/healthcheck.map ${BASE_DIR}/etc/
COPY --chmod=755 fcgi/start.sh /start.sh
# health check command shared by every runtime (see HEALTHCHECK below)
